# Copy to .env and adjust. Read by docker compose.

TRAILPLANNER_PORT=8080

# Your riding area: "latitude,longitude" or "latitude,longitude,zoom" (copy it from any map app).
# The map opens there on a first visit, and ./scripts/download-segments.sh downloads the routing
# data around it (about 100 km). Empty: Luxembourg. Example for Bern: 46.95,7.45,11
TRAILPLANNER_AREA=

# Host names you open Trail Planner under, if not an IP address or localhost (comma-separated, e.g.
# trailplanner.home,nas.local). Other names are refused to protect against DNS rebinding.
TRAILPLANNER_ALLOWED_HOSTS=
