# Copy to .env and adjust. Read by docker compose.

# Where you open the planner in the browser (used for the Wahoo login redirect).
TRAILPLAN_PUBLIC_URL=http://localhost:8080
TRAILPLAN_PORT=8080

# Optional direct sync via the Wahoo Cloud API (register an app at developers.wahooligan.com,
# redirect URI: <TRAILPLAN_PUBLIC_URL>/api/wahoo/callback). USB copy and GPX import work without it.
WAHOO_ENABLED=false
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
